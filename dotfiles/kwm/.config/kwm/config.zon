            .{
                .keysym = "w",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "/home/ax/syscfg/scripts/bb/weather.clj", "dunst" } },
                        },
