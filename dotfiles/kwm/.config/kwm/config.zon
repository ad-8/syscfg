            },
            .{
                .keysym = "Left",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "/home/ax/syscfg/scripts/wayland.clj", "volume-mute" } },
                        },
                    },
                },
            },
            .{
                .keysym = "Up",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "/home/ax/syscfg/scripts/wayland.clj", "volume-up" } },
                        },
                    },
                },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
