#!/bin/sh

# tells xdg-desktop-portal which backend config to load
# (/etc/xdg/xdg-desktop-portal/river-portals.conf); bare river sets nothing
export XDG_CURRENT_DESKTOP=river

# hands these vars to the user systemd manager, so gui user services can
# reach the display -- this is what the polkit agent died without
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# same for dbus-activated services (portals, secret service), which systemd
# does not start; upstream xdg-desktop-portal-wlr documents this exact line
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

systemctl --user start river-session.target

# graphical-session.target refuses manual start, so start the agent directly;
# nothing else pulls it in under bare river
/usr/libexec/polkit-mate-authentication-agent-1 &

status_fifo="$XDG_RUNTIME_DIR/kwm-status"
pkill -f kwm_status.janet
rm -f "$status_fifo"
mkfifo "$status_fifo"

sleep 2

export PATH="$HOME/.local/bin:$HOME/git/kwim/zig-out/bin:$PATH"
exec /home/ax/git/kwm/zig-out/bin/kwm
