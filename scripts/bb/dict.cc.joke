#!/usr/bin/env joker

(require '[joker.http :as http])
(require '[joker.string :as str])
(require '[joker.os :as os])
(require '[joker.strconv :as strconv])
(require '[joker.html :as html])
(require '[joker.url :as url])
(require '[joker.pprint :refer [print-table]])

(def user-agent "Mozilla/5.0 (Windows NT 6.1;) Gecko/20100101 Firefox/141.0.3")

(defn fetch-page
  "Fetches dict.cc's result page for `word` and returns its HTML."
  [word]
  (:body (http/send {:url     (str "https://www.dict.cc/?s=" (url/query-escape word))
                     :method  :get
                     :headers {"User-Agent" user-agent}})))

(defn result-cells
  "Extracts the inner HTML of each result cell in `page`, English and German alternating."
  [page]
  (map second (re-seq #"(?s)<td[^>]*class=\"td7nl\"[^>]*>(.*?)</td>" page)))

(defn upvotes
  "Returns the upvote count in `cell`, or 0 if it has none."
  [cell]
  (if-let [[_ n] (re-find #"(?s)<div[^>]*>(\d+)</div>" cell)]
    (strconv/atoi n)
    0))

(defn cell-text
  "Strips `cell` to its plain text, without upvotes, subject labels, word classes and case markers."
  [cell]
  (let [plain (-> cell
                  ;; only strip the upvote div (digit-only content);
                  ;; the new elliwrap div wraps translation <a> tags
                  (str/replace #"(?s)<div[^>]*>\d+</div>" "")
                  (str/replace #"(?s)<dfn[^>]*>.*?</dfn>" "")
                  (str/replace #"(?s)<var[^>]*>.*?</var>" "")
                  (str/replace #"(?s)<sup[^>]*>.*?</sup>" "")
                  (str/replace #"<[^>]+>" " ")
                  html/unescape)]
    (->> (re-seq #"\S+" plain)
         (remove #(= " " %))
         (str/join " "))))

(defn ->row
  "Builds a row map with `:en`, `:de` and `:upvotes` from an English and a German cell."
  [[en de]]
  {:en      (cell-text en)
   :de      (cell-text de)
   :upvotes (upvotes de)})

(defn lookup
  "Looks up `word` on dict.cc and returns its rows, most upvoted first."
  [word]
  (->> (fetch-page word)
       result-cells
       (partition 2)
       (map ->row)
       (sort-by :upvotes >)))

(defn search-term
  "Joins the words in `args` with `+`, splitting arguments that hold several words."
  [args]
  (->> args
       (mapcat #(str/split % #"\s+"))
       (remove str/blank?)
       (str/join "+")))

(let [[flag & words :as args] (drop 2 (os/args))]
  (if-let [[_ n] (re-matches #"-(\d+)" flag)]
    (prn (take (strconv/atoi n) (lookup (search-term words))))
    (print-table (take 5 (lookup (search-term args))))))
