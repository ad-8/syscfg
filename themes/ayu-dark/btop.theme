# Ayu Dark color theme for btop
# Based on btop's bundled ayu.theme, colors moved to the ayu 9.1.0 dark palette
# https://github.com/ayu-theme/ayu-colors

theme[main_bg]=""
theme_background=false
theme[main_fg]="#bfbdb6"
