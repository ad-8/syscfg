/**
 * Ayu Dark rofi theme
 * https://github.com/ayu-theme/ayu-colors
 */

* {
    aybg:      #0d1017;
    aybg1:     #475266;
    aybg4:     #5a6673;
    ayfg:      #bfbdb6;
    ayfg2:     #ffffff;
    ayaccent:  #e6b450;
    aycyan:    #95e6cb;
    aygreen:   #aad94c;

    foreground:       @ayfg;
    background-color: transparent;

    highlight:   underline bold #ffffff;
    transparent: rgba(13, 16, 23, 0);
}

window {
    location: center;
    anchor:   center;
    transparency: "screenshot";
    padding: 10px;
    border:  0px;
    border-radius: 6px;

    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;

    width: 33%;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @aybg;
    padding: 5;
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    background-color: @aygreen;
}

inputbar {
    color: @ayfg;
    padding: 11px;
    background-color: #475266;

    border: 1px;
    border-radius:  6px 6px 0px 0px;
    border-color: @ayaccent;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 6px 6px;
    border-color: @ayaccent;
    border: 0px 1px 1px 1px;
    background-color: rgba(13, 16, 23, 0.9);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @ayaccent;
    text-color: #0d1017;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: underline bold #0d1017;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
