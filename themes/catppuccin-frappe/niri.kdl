// catppuccin-frappe
// Themed via switch_theme.clj. Colors sourced from themes/catppuccin-frappe/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#303446"

    border {
        active-color   "#ca9ee6"
        inactive-color "#414559"
        urgent-color   "#e78284" // windows requesting attention
    }

    tab-indicator {
        active-color "#ca9ee6"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#303446"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#ca9ee6"
        urgent-color "#e78284"
    }
}
