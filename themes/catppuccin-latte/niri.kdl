// catppuccin-latte
// Themed via switch_theme.clj. Colors sourced from themes/catppuccin-latte/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#eff1f5"

    border {
        active-color   "#8839ef"
        inactive-color "#ccd0da"
        urgent-color   "#d20f39" // windows requesting attention
    }

    tab-indicator {
        active-color "#8839ef"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#eff1f5"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#8839ef"
        urgent-color "#d20f39"
    }
}
