// catppuccin-mocha
// Themed via switch_theme.clj. Colors sourced from themes/catppuccin-mocha/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#1e1e2e"

    border {
        active-color   "#cba6f7"
        inactive-color "#313244"
        urgent-color   "#f38ba8" // windows requesting attention
    }

    tab-indicator {
        active-color "#cba6f7"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#1e1e2e"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#cba6f7"
        urgent-color "#f38ba8"
    }
}
