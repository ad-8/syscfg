/**
 * Catppuccin Mocha rofi theme
 * Colors from https://github.com/catppuccin/palette
 */

* {
    ctpbg:     #1e1e2e;
    ctpbg1:    #313244;
    ctpbg4:    #6c7086;
    ctpfg:     #cdd6f4;
    ctpfg2:    #cdd6f4;
    ctpaccent: #cba6f7;
    ctpsky:    #89dceb;
    ctpgreen:  #a6e3a1;

    foreground:       @ctpfg;
    background-color: transparent;

    highlight:   underline bold #cdd6f4;
    transparent: rgba(30, 30, 46, 0);
}

window {
    location: center;
    anchor:   center;
    transparency: "screenshot";
    padding: 10px;
    border:  0px;
    border-radius: 6px;

    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;

    width: 33%;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @ctpbg;
    padding: 5;
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    background-color: @ctpgreen;
}

inputbar {
    color: @ctpfg;
    padding: 11px;
    background-color: #313244;

    border: 1px;
    border-radius:  6px 6px 0px 0px;
    border-color: @ctpaccent;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 6px 6px;
    border-color: @ctpaccent;
    border: 0px 1px 1px 1px;
    background-color: rgba(30, 30, 46, 0.9);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @ctpaccent;
    text-color: #1e1e2e;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: underline bold #1e1e2e;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
