/**
 * Oak rofi theme
 * Protesilaos doric-oak
 */

* {
    oak0: #e0d8c7;
    oak1: #d5c9b5;
    oak2: #c2b19e;
    oak3: #8f9373;
    oak4: #6b5225;
    oak5: #3a2018;
    oak6: #0f5420;
    oak7: #53402f;

    foreground:       @oak5;
    background-color: transparent;

    highlight:   underline bold #0f5420;
    transparent: rgba(224, 216, 199, 0);
}

window {
    location: center;
    anchor:   center;
    transparency: "screenshot";
    padding: 10px;
    border:  0px;
    border-radius: 6px;

    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;

    width: 33%;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @oak0;
    padding: 5;
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    background-color: @oak6;
}

inputbar {
    color: @oak5;
    padding: 11px;
    background-color: #d5c9b5;

    border: 1px;
    border-radius:  6px 6px 0px 0px;
    border-color: @oak6;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 6px 6px;
    border-color: @oak6;
    border: 0px 1px 1px 1px;
    background-color: rgba(224, 216, 199, 0.95);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    color: @foreground;
    text-color: rgb(58, 32, 24);
}

element selected.normal {
    background-color: @oak6;
    text-color: #e0d8c7;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
