// gotham
// Themed via switch_theme.clj. Colors sourced from themes/gotham/hyprland.lua
// (accent / red), matching hyprland's border convention.
// Inactive border and tab-indicator from foot.theme bright2.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#0c1014"

    border {
        active-color   "#245361"
        inactive-color "#091f2e"
        urgent-color   "#c23127" // windows requesting attention
    }

    tab-indicator {
        active-color "#245361"
        inactive-color "#091f2e"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#0c1014"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#245361"
        urgent-color "#c23127"
    }
}
