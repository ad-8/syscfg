// gruvbox-dark
// Themed via switch_theme.clj. Colors sourced from themes/gruvbox-dark/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Inactive border and tab-indicator from btop.theme free_mid (gruvbox bg2).
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#282828"

    border {
        active-color   "#fabd2f"
        inactive-color "#504945"
        urgent-color   "#cc241d" // windows requesting attention
    }

    tab-indicator {
        active-color "#fabd2f"
        inactive-color "#504945"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#282828"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#fabd2f"
        urgent-color "#cc241d"
    }
}
