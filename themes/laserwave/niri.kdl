// laserwave
// Themed via switch_theme.clj. Colors sourced from themes/laserwave/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Inactive border and tab-indicator from foot.theme selection-background.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#27212e"

    border {
        active-color   "#eb64b9"
        inactive-color "#3e3549"
        urgent-color   "#964c7b" // windows requesting attention
    }

    tab-indicator {
        active-color "#eb64b9"
        inactive-color "#3e3549"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#27212e"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#eb64b9"
        urgent-color "#964c7b"
    }
}
