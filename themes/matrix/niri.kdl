// matrix
// Themed via switch_theme.clj. Colors sourced from themes/matrix/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Inactive border and tab-indicator from foot.theme regular0.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#000000"

    border {
        active-color   "#00ff88"
        inactive-color "#004022"
        urgent-color   "#cc0037" // windows requesting attention
    }

    tab-indicator {
        active-color "#00ff88"
        inactive-color "#004022"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#000000"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#00ff88"
        urgent-color "#cc0037"
    }
}
