/**
 * Modus Operandi rofi theme
 * Colors from https://protesilaos.com/emacs/modus-themes (modus-operandi-palette)
 */

* {
    mobg:     #ffffff;
    mobgdim:  #f2f2f2;
    mobgact:  #c4c4c4;
    mofg:     #000000;
    mofgdim:  #595959;
    moblue:   #0031a9;
    mocyan:   #005e8b;
    moline:   #9f9f9f;

    foreground:       @mofg;
    background-color: transparent;

    highlight:   underline bold #0031a9;
    transparent: rgba(255, 255, 255, 0);
}

window {
    location: center;
    anchor:   center;
    transparency: "screenshot";
    padding: 10px;
    border:  0px;
    border-radius: 6px;

    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;

    width: 33%;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @mobg;
    padding: 5;
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    background-color: @mocyan;
}

inputbar {
    color: @mofg;
    padding: 11px;
    background-color: #f2f2f2;

    border: 1px;
    border-radius:  6px 6px 0px 0px;
    border-color: @moblue;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 6px 6px;
    border-color: @moblue;
    border: 0px 1px 1px 1px;
    background-color: rgba(255, 255, 255, 0.9);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    color: @foreground;
    text-color: rgb(0, 0, 0);
}

element selected.normal {
    background-color: @mocyan;
    text-color: #ffffff;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: underline bold #ffffff;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
