// osaka-jade
// Themed via switch_theme.clj. Colors sourced from themes/osaka-jade/hyprland.lua
// (accent / red) + foot.theme background, matching hyprland's border convention.
// Inactive border and tab-indicator from btop.theme selected_bg.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#111c18"

    border {
        active-color   "#509475"
        inactive-color "#364538"
        urgent-color   "#ff5345" // windows requesting attention
    }

    tab-indicator {
        active-color "#509475"
        inactive-color "#364538"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#111c18"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#509475"
        urgent-color "#ff5345"
    }
}
