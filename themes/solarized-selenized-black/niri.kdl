// solarized-selenized-black
// Themed via switch_theme.clj. Colors sourced from themes/solarized-selenized-black/hyprland.lua
// (accent / black / red) + foot.theme background, matching hyprland's border convention.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#181818"

    border {
        active-color   "#70b433"
        inactive-color "#252525"
        urgent-color   "#ed4a46" // windows requesting attention
    }

    tab-indicator {
        active-color "#70b433"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#181818"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#70b433"
        urgent-color "#ed4a46"
    }
}
