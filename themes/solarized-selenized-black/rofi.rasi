/**
 * Selenized black colors on the house rofi layout (from solarized-dark)
 * https://github.com/jan-warchol/selenized
 */

* {
    solbase03: #181818;
    solbase02: #252525;
    solbase01: #777777;
    solbase0:  #b9b9b9;
    solbase1:  #dedede;
    solblue:   #368aeb;
    solcyan:   #3fc5b7;
    solorange: #e67f43;

    foreground:       @solbase0;
    background-color: transparent;

    highlight:   underline bold #e67f43;
    transparent: rgba(24, 24, 24, 0);
}

window {
    location: center;
    anchor:   center;
    transparency: "screenshot";
    padding: 10px;
    border:  0px;
    border-radius: 6px;

    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;

    width: 33%;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    color: @solbase03;
    padding: 5;
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    background-color: @solcyan;
}

inputbar {
    color: @solbase1;
    padding: 11px;
    background-color: #252525;

    border: 1px;
    border-radius:  6px 6px 0px 0px;
    border-color: @solblue;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 6px 6px;
    border-color: @solblue;
    border: 0px 1px 1px 1px;
    background-color: rgba(24, 24, 24, 0.9);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @solcyan;
    text-color: #181818;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: underline bold #181818;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}
