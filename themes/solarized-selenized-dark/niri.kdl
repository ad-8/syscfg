// solarized-selenized-dark
// Themed via switch_theme.clj. Colors sourced from themes/solarized-selenized-dark/hyprland.lua
// (accent / black / red) + foot.theme background, matching hyprland's border convention.
// Merged per-property over config.kdl's layout block via `include`.
layout {
    background-color "#103c48"

    border {
        active-color   "#75b938"
        inactive-color "#184956"
        urgent-color   "#fa5750" // windows requesting attention
    }

    tab-indicator {
        active-color "#75b938"
    }
}

// overview/between-workspace void; global block merges (per-output backdrop does not)
overview {
    backdrop-color "#103c48"
}

// alt-tab switcher highlight behind the focused preview
recent-windows {
    highlight {
        active-color "#75b938"
        urgent-color "#fa5750"
    }
}
