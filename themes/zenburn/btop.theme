# Zenburn color theme for btop
# https://github.com/jnurmine/Zenburn/blob/9d7988abf0d2654f837fcd288145afd5f316b70c/colors/zenburn.vim

theme[main_bg]=""
theme_background=false
theme[main_fg]="#dcdccc"
theme[title]="#efefef"
theme[hi_fg]="#f0dfaf"
theme[selected_bg]="#f0dfaf"
theme[selected_fg]="#3f3f3f"
theme[inactive_fg]="#8f8f8f"
theme[graph_text]="#dcdccc"
theme[meter_bg]="#333333"
theme[proc_misc]="#8cd0d3"

theme[cpu_box]="#7f9f7f"
theme[mem_box]="#f0dfaf"
theme[net_box]="#8cd0d3"
theme[proc_box]="#8faf9f"
theme[div_line]="#4f4f4f"

